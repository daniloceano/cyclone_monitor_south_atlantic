# ─── South Atlantic Cyclone Monitor — Environment Variables ──────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, set these variables in the Vercel dashboard
# under Project Settings → Environment Variables.

# ── Authentication ────────────────────────────────────────────────────────────
# Password required to access the cyclone monitor.
# Must be set before running the app. If unset, the login API returns 500.
SITE_PASSWORD=tc_petrobras

# ── Optional ──────────────────────────────────────────────────────────────────
# Node environment (set automatically by Next.js/Vercel; rarely needs manual override).
# NODE_ENV=development
