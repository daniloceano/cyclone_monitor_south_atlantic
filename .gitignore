*.tmp
*.temp

# Raw data (large CSV — not committed)
data/raw/

# Processed data (large CSV — regeneratable via pipeline)
data/processed/*.csv

# Intermediate data products (keep README, ignore everything else)
data/interim/*
!data/interim/README.md

# Per-cyclone Parquet files (regeneratable via scripts/data/merge_wind.py)
# Keep the merge report for provenance; ignore the binary Parquet tree.
# NOTE: the directory contents are ignored with '/*' rather than the directory
# itself with '/'. A directory-level ignore cannot be undone by a later
# negation, so the previous 'data/processed/tracks_by_id/' rule silently
# excluded merge_report.txt too, defeating the stated intent.
data/processed/tracks_by_id/*
!data/processed/tracks_by_id/merge_report.txt

# Parquet files (anywhere). This covers both the per-cyclone tree above and
# data/processed/cyclones.parquet — the large consolidated products live on
# swell, never in git. The small JSON taxonomy index beside them IS committed:
# it is ~150 KB and is what a reader needs to answer "which cyclones are
# subtropical?" without the binaries.
*.parquet

# Processed artefacts — regenerated by `python3 scripts/preprocess_data.py`
# Commit these for Vercel deployments; un-comment to exclude locally.
# site/public/data/summary.json
# site/public/data/details/

# Wind JSON files (~305 MB uncompressed, one file per year holding every level).
# Regenerate from the consolidated Parquet base with:
#   conda run -n paper_energy_patterns python scripts/generate_wind_json.py
# Committed for Vercel deployments (same strategy as details/). Un-comment to
# exclude locally.
# site/public/data/wind/

# Build artifacts
.vercel/
.turbo/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Keep these
!.env.example
!README.md
!**/README.md
