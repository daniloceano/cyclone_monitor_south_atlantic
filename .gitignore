# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Raw data (large CSV — not committed)
data/raw/

# Processed data (large CSV — regeneratable via pipeline)
data/processed/*.csv

# Intermediate data products (keep README, ignore everything else)
data/interim/*
!data/interim/README.md

# Per-cyclone Parquet files (regeneratable via merge_wind100.py)
# Keep the merge report for provenance; ignore the binary Parquet tree
data/processed/tracks_by_id/

# Parquet files (anywhere)
*.parquet

# Processed artefacts — regenerated by `python3 scripts/preprocess_data.py`
# Commit these for Vercel deployments; un-comment to exclude locally.
# site/public/data/summary.json
# site/public/data/details/

# Wind100 JSON files (~249 MB uncompressed, regeneratable from data/raw/wind100/).
# Regenerate with: conda run -n data python scripts/generate_wind100_json.py
# Must be present in site/public/data/wind100/ before `npm run build` or `npm run dev`.
site/public/data/wind100/

# Build artifacts
.vercel/
.turbo/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Keep these
!.env.example
!README.md
!**/README.md
