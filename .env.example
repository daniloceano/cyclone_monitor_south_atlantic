# South Atlantic Cyclone Monitor - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Site Authentication (for future implementation)
# ============================================================================
# Password for accessing the interactive monitor
# SITE_PASSWORD=your_secure_password_here

# ============================================================================
# Deployment (for future Vercel deployment)
# ============================================================================
# Public URL of the deployed application
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ============================================================================
# Data Sources (if using external APIs in the future)
# ============================================================================
# Example: API keys for meteorological data services
# METEO_API_KEY=your_api_key_here

# ============================================================================
# Development
# ============================================================================
# Node environment
# NODE_ENV=development
